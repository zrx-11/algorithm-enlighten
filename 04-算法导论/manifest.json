      "chapterId": "ch05"
    },
    {
      "term": "堆",
      "def": "父键≥子键的完全二叉树数组",
      "chapterId": "ch06"
    },
    {
      "term": "优先队列",
      "def": "支持取最大/最小的队列",
      "chapterId": "ch06"
    },
    {
      "term": "计数排序",
      "def": "用计数桶的线性时间排序",
      "chapterId": "ch08"
    },
    {
      "term": "栈",
