  "glossary": [
    {
      "term": "二分查找",
      "def": "只在有序列表上用，每次猜中间元素砍掉一半范围的查找法",
      "chapterId": "ch01"
    },
    {
      "term": "对数",
      "def": "幂运算的逆运算；log₂n 问几个 2 相乘等于 n",
      "chapterId": "ch01"
    },
    {
      "term": "大O表示法",
      "def": "描述算法操作数随 n 增速的记号，看最糟情况、忽略常数",
      "chapterId": "ch01"
    },
    {
      "term": "线性时间 O(n)",
      "def": "操作数与 n 成正比，如简单查找",
      "chapterId": "ch01"
    },
    {
      "term": "对数时间 O(log n)",
      "def": "每翻倍数据量只多一步，如二分查找",
      "chapterId": "ch01"
    },
    {
      "term": "阶乘时间 O(n!)",
      "def": "试遍所有排列，如旅行商蛮力解",
      "chapterId": "ch01"
    },
    {
      "term": "数组",
      "def": "元素紧挨存放、靠编号直接定位的数据结构",
      "chapterId": "ch02"
    },
    {
      "term": "链表",
      "def": "元素散落、每个元素存下一个地址的串联结构",
      "chapterId": "ch02"
    },
    {
      "term": "索引",
      "def": "数组元素的位置编号，从 0 开始",
      "chapterId": "ch02"
    },
    {
      "term": "随机访问",
      "def": "直接跳到任意位置（数组支持）",
      "chapterId": "ch02"
    },
    {
      "term": "选择排序",
      "def": "反复找最小挪到新列表的排序，O(n²)",
      "chapterId": "ch02"
    },
    {
      "term": "递归",
      "def": "调用自身的函数",
      "chapterId": "ch03"
    },
    {
      "term": "基线条件",
      "def": "递归中不再调用自己、直接返回的刹车",
      "chapterId": "ch03"
    },
    {
      "term": "栈",
      "def": "后进先出（LIFO）的数据结构",
      "chapterId": "ch03"
    },
    {
      "term": "调用栈",
      "def": "计算机用栈记住每个进行到一半的函数",
      "chapterId": "ch03"
    },
    {
      "term": "栈溢出",
      "def": "递归太深调用栈占满内存导致崩溃",
      "chapterId": "ch03"
    },
    {
      "term": "分而治之 D&C",
      "def": "找最简基线条件、每次递归缩小问题规模",
      "chapterId": "ch04"
    },
    {
      "term": "基准值 pivot",
      "def": "快速排序中被选为分数线的那个元素",
      "chapterId": "ch04"
    },
    {
      "term": "快速排序",
      "def": "选基准值分区后递归排序，平均 O(n log n)",
      "chapterId": "ch04"
    },
    {
      "term": "散列函数",
      "def": "把任意输入映射为数字；要求一致且均匀",
      "chapterId": "ch05"
    },
    {
      "term": "散列表",
      "def": "散列函数 + 数组，查找/插入/删除平均 O(1)",
      "chapterId": "ch05"
    },
    {
      "term": "冲突",
      "def": "两个不同的键被散列到同一数组位置",
      "chapterId": "ch05"
    },
    {
      "term": "填装因子",
      "def": "已占用位置 ÷ 总位置；>0.7 需扩容",
      "chapterId": "ch05"
    },
    {
      "term": "图",
      "def": "由节点和边组成的连接结构",
      "chapterId": "ch06"
    },
    {
      "term": "节点",
      "def": "图中的一个点",
      "chapterId": "ch06"
    },
    {
      "term": "边",
      "def": "图中两节点之间的连线",
      "chapterId": "ch06"
    },
    {
      "term": "队列",
      "def": "先进先出（FIFO）的数据结构",
      "chapterId": "ch06"
    },
    {
      "term": "广度优先搜索 BFS",
      "def": "从起点按圈层向外扩展，找段数最短路径",
      "chapterId": "ch06"
    },
    {
      "term": "拓扑排序",
      "def": "把依赖图排成被依赖者在前的有序列表",
      "chapterId": "ch06"
    },
    {
      "term": "权重",
      "def": "边上的数字，表示距离/时间/费用",
      "chapterId": "ch07"
    },
    {
      "term": "加权图",
      "def": "边带权重的图",
      "chapterId": "ch07"
    },
    {
      "term": "狄克斯特拉算法",
      "def": "加权图中找总权重最小路径的算法",
      "chapterId": "ch07"
    },
    {
      "term": "负权边",
      "def": "权重为负的边；狄克斯特拉失效",
      "chapterId": "ch07"
    },
    {
      "term": "贪婪算法",
      "def": "每步选局部最优、拼全局的简单策略",
      "chapterId": "ch08"
    },
    {
      "term": "近似算法",
      "def": "精确解太慢时求接近最优的快速解",
      "chapterId": "ch08"
    },
    {
      "term": "集合覆盖问题",
      "def": "用最少集合覆盖所有元素的 NP 完全问题",
      "chapterId": "ch08"
    },
    {
      "term": "NP完全问题",
      "def": "目前无快速解法、只能近似的难题",
      "chapterId": "ch08"
    },
    {
      "term": "动态规划",
      "def": "建网格逐格填子问题最优解的方法",
      "chapterId": "ch09"
    },
    {
      "term": "最长公共子串",
      "def": "两字符串中连续相同的最长片段",
      "chapterId": "ch09"
    },
    {
      "term": "最长公共子序列",
      "def": "顺序相同、可跳着取的最长公共序列",
      "chapterId": "ch09"
    },
    {
      "term": "K最近邻 KNN",
      "def": "找最近 K 个邻居做分类或回归的算法",
      "chapterId": "ch10"
    },
    {
      "term": "特征",
      "def": "把物品量化成的一组可比数字",
      "chapterId": "ch10"
    },
    {
      "term": "分类",
      "def": "把新样本编入已知类别（投票）",
      "chapterId": "ch10"
    },
    {
      "term": "回归",
      "def": "预测一个数值（邻居数值平均）",
      "chapterId": "ch10"
    },
    {
      "term": "二叉查找树",
      "def": "左小右大的树；查找平均 O(log n)",
      "chapterId": "ch11"
    },
    {
      "term": "布隆过滤器",
      "def": "概率型集合判断：可能错报、绝不漏报",
      "chapterId": "ch11"
    },
    {
      "term": "SHA",
      "def": "单向安全散列算法，用于比对文件/存密码",
      "chapterId": "ch11"
    }
  ],
