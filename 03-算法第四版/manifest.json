  "quizzes": [
    {"id": "q01", "chapterId": "ch01a", "type": "single", "question": "二分查找要求输入数组满足什么前提？", "options": ["元素全不同", "已排好序", "元素个数为2的幂", "元素为整数"], "answer": 1, "explain": "二分查找靠中间值排除一半，前提是左边全小右边全大即数组有序。"},
    {"id": "q02", "chapterId": "ch01c", "type": "single", "question": "栈的进出规则是？", "options": ["先进先出", "后进先出", "随机存取", "只进不出"], "answer": 1, "explain": "栈 LIFO，像弹夹最后压入的最先打出。"},
    {"id": "q03", "chapterId": "ch01d", "type": "single", "question": "倍率实验中 t(2N)/t(N) 趋近 4，算法是几阶？", "options": ["线性", "二阶", "三阶", "对数"], "answer": 1, "explain": "时间∝N^b，翻倍后比值 2^b=4 → b=2，即 O(N²)。"},
    {"id": "q04", "chapterId": "ch01e", "type": "blank", "question": "加权 quick-union 中“加权”指记录______，把小树挂到大树根下。", "options": [], "answer": "树的大小", "explain": "sz[] 记录每树节点数，小树并入大树，防退化成链。"},
    {"id": "q05", "chapterId": "ch02a", "type": "single", "question": "插入排序的交换次数等于数组中什么？", "options": ["元素总数", "倒置数量", "逆序对的一半", "最大值"], "answer": 1, "explain": "每消除一个倒置恰好一次交换，故交换次数=倒置数。"},
    {"id": "q06", "chapterId": "ch02b", "type": "single", "question": "归并排序最坏比较次数约为？", "options": ["N", "N log N", "N²", "2^N"], "answer": 1, "explain": "命题 H，归并最坏 ~N lg N，已触比较排序下界。"},
    {"id": "q07", "chapterId": "ch02c", "type": "single", "question": "快速排序平均比较次数约为？", "options": ["N", "1.39 N lg N", "N²", "2N"], "answer": 1, "explain": "~2N ln N ≈ 1.39 N lg N，只比最好情况多 39%。"},
    {"id": "q08", "chapterId": "ch02e", "type": "multi", "question": "下列哪些排序是稳定的？", "options": ["选择排序", "插入排序", "归并排序", "堆排序"], "answer": [1, 2], "explain": "插入、归并稳定；选择、堆排序不稳定。"},
    {"id": "q09", "chapterId": "ch03b", "type": "single", "question": "随机 N 键构造的 BST，平均查找命中约为？", "options": ["log N", "1.39 lg N", "N", "N²"], "answer": 1, "explain": "命题 C，~2 ln N ≈ 1.39 lg N。"},
    {"id": "q10", "chapterId": "ch03c", "type": "single", "question": "红黑树 N 节点的高度上界是？", "options": ["lg N", "2 lg N", "N", "N²"], "answer": 1, "explain": "命题 G，红黑树高 ≤ 2 lg N。"},
    {"id": "q11", "chapterId": "ch03d", "type": "single", "question": "散列表线性探测要求装载因子 α 控制在？", "options": ["≤ 1/2", "≤ 1", "≤ 2", "任意"], "answer": 0, "explain": "α=N/M ≤ 1/2，否则探测链过长。"},
    {"id": "q12", "chapterId": "ch03d", "type": "single", "question": "散列表为什么不支持 rank/select？", "options": ["速度慢", "散列打乱键顺序，无有序结构", "内存不够", "键不可比较"], "answer": 1, "explain": "散列把键映射到槽，破坏了键的有序性。"},
    {"id": "q13", "chapterId": "ch04a", "type": "single", "question": "为什么 BFS 能求最短路径？", "options": ["它用栈", "按距离从小到大访问，首次到达即最短", "它遍历所有边", "它递归"], "answer": 1, "explain": "BFS 波纹式扩散，先到的层距离短。"},
    {"id": "q14", "chapterId": "ch04c", "type": "single", "question": "切分定理说横切边中哪条必入 MST？", "options": ["最长的", "权重最小的", "任意一条", "中间的"], "answer": 1, "explain": "最小横切边必属 MST，是 Prim/Kruskal 的基石。"},
    {"id": "q15", "chapterId": "ch04d", "type": "single", "question": "Dijkstra 算法要求什么前提？", "options": ["图是 DAG", "边权非负", "图无环", "顶点数为偶"], "answer": 1, "explain": "边权非负，否则锁定后还可能出现更短路。"},
    {"id": "q16", "chapterId": "ch04c", "type": "blank", "question": "Kruskal 用______判断两端是否已连通。", "options": [], "answer": "并查集", "explain": "并查集近常数判断连通，配合边排序。"},
    {"id": "q17", "chapterId": "ch05a", "type": "single", "question": "LSD 字符串排序要求字符串满足？", "options": ["变长", "等长", "全相同", "为整数"], "answer": 1, "explain": "LSD 从最右位逐位分桶，前提是等长。"},
    {"id": "q18", "chapterId": "ch05c", "type": "single", "question": "KMP 相对暴力查找的关键改进是？", "options": ["更快的散列", "失配不回退文本指针", "用队列", "递归"], "answer": 1, "explain": "KMP 用 DFA 决定模式指针位置，不回退 i。"},
    {"id": "q19", "chapterId": "ch05e", "type": "single", "question": "霍夫曼编码中频率高的字符编码？", "options": ["更长", "更短", "相同", "随机"], "answer": 1, "explain": "高频字符离根近，路径短，编码短。"},
    {"id": "q20", "chapterId": "ch02e", "type": "single", "question": "下列哪种组合能正确描述“先排序再二分查找”？", "options": ["归并排序 O(N log N) + 二分 O(log N)", "快排 O(N²) + 二分 O(N)", "堆排序 O(N) + 二分 O(log N)", "插入 O(N) + 二分 O(1)"], "answer": 0, "explain": "归并 N log N 保证，二分 log N；其余成本配错。"},
    {"id": "q21", "chapterId": "ch03c", "type": "multi", "question": "下列哪些结构“查找最坏不是 O(log N)”？", "options": ["普通 BST", "红黑树", "散列表(碰撞)", "有序数组"], "answer": [0, 2], "explain": "BST 有序插入退化 O(N)；散列碰撞链 O(N)。红黑树、有序数组有对数保证。"},
    {"id": "q22", "chapterId": "ch02d", "type": "single", "question": "要在内存极紧的实时系统中排 10^7 个元素且要 O(N log N) 最坏保证，选？", "options": ["快速排序", "堆排序", "归并排序", "选择排序"], "answer": 1, "explain": "堆排序原地 O(1) 额外空间 + O(N log N) 最坏保证。"}
  ],
