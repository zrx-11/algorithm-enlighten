  "glossary": [
    {"term": "二分查找", "def": "在有序数组里每次和中间元素比、排除一半的查找法", "chapterId": "ch01a"},
    {"term": "递归", "def": "方法调用自身解决更小规模同类问题", "chapterId": "ch01a"},
    {"term": "抽象数据类型 ADT", "def": "数据+一组操作，只露 API 藏内部", "chapterId": "ch01b"},
    {"term": "栈", "def": "后进先出 LIFO 的存取结构", "chapterId": "ch01c"},
    {"term": "队列", "def": "先进先出 FIFO 的存取结构", "chapterId": "ch01c"},
    {"term": "链表", "def": "节点串成的序列，每节点含数据+下一节点指针", "chapterId": "ch01c"},
    {"term": "均摊成本", "def": "把偶尔昂贵操作平摊到每次操作上", "chapterId": "ch01c"},
    {"term": "增长数量级", "def": "忽略常数和低阶项后函数的类别", "chapterId": "ch01d"},
    {"term": "大 O", "def": "运行时间的上界（常数倍内）", "chapterId": "ch01d"},
    {"term": "倍率实验", "def": "输入翻倍看时间比值定阶数", "chapterId": "ch01d"},
    {"term": "并查集", "def": "维护连通分组、支持 union/find 的结构", "chapterId": "ch01e"},
    {"term": "路径压缩", "def": "find 时把路过节点直接指向根", "chapterId": "ch01e"},
    {"term": "倒置", "def": "数组中一对顺序反了的元素", "chapterId": "ch02a"},
    {"term": "归并", "def": "两个有序半场合并成一个有序数组", "chapterId": "ch02b"},
    {"term": "切分", "def": "选基准小左大右、基准归位", "chapterId": "ch02c"},
    {"term": "优先队列", "def": "按最值出队的队列", "chapterId": "ch02d"},
    {"term": "堆", "def": "父≥子的完全二叉树", "chapterId": "ch02d"},
    {"term": "符号表", "def": "键值对字典，核心 put/get", "chapterId": "ch03a"},
    {"term": "二叉查找树", "def": "左子树键<根<右子树键的二叉树", "chapterId": "ch03b"},
    {"term": "红黑树", "def": "2-3 树的二叉编码，红链接绑 3-节点", "chapterId": "ch03c"},
    {"term": "散列函数", "def": "把 key 压成数组下标的函数", "chapterId": "ch03d"},
    {"term": "装载因子", "def": "α=N/M，键数/槽数", "chapterId": "ch03d"},
    {"term": "DAG", "def": "有向无环图", "chapterId": "ch04b"},
    {"term": "拓扑排序", "def": "把 DAG 排成合法依赖序", "chapterId": "ch04b"},
    {"term": "最小生成树", "def": "总权重最小的生成树", "chapterId": "ch04c"},
    {"term": "切分定理", "def": "最小横切边必入 MST", "chapterId": "ch04c"},
    {"term": "Dijkstra", "def": "非负权下求最短路的算法", "chapterId": "ch04d"},
    {"term": "Trie", "def": "边=字符、路径=键的查找树", "chapterId": "ch05b"},
